+
+/* SM-FRONT-NOSOTROS-003 — presentación institucional. */
+#nosotros { background: #102a43; color: #fff; }
+#nosotros > .container { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: clamp(2rem, 5vw, 4rem); }
+#nosotros .nosotros-presentacion { min-width: 0; }
+#nosotros .nosotros-acento { display: block; width: 3rem; height: 4px; margin-bottom: 1.5rem; border-radius: 2px; background: #f0c35b; }
+#nosotros h2 { color: #fff; margin-bottom: 1.5rem; }
+#nosotros .nosotros-presentacion p { margin-bottom: 0; color: #e0eaf1; font-size: clamp(1.125rem, 1.7vw, 1.375rem); line-height: 1.75; }
+#nosotros .nosotros-conceptos { min-width: 0; margin: 0; padding: clamp(1.25rem, 3vw, 2rem); list-style: none; border: 1px solid #dce7ec; border-radius: 1.25rem; background: #fff; box-shadow: 0 12px 32px rgb(0 0 0 / 12%); }
+#nosotros .nosotros-conceptos li { display: flex; align-items: flex-start; gap: 1rem; padding-block: 1.25rem; }
+#nosotros .nosotros-conceptos li:first-child { padding-top: 0; }
+#nosotros .nosotros-conceptos li:last-child { padding-bottom: 0; }
+#nosotros .nosotros-conceptos li + li { border-top: 1px solid #dce7ec; }
+#nosotros .nosotros-conceptos li > div { min-width: 0; overflow-wrap: anywhere; }
+#nosotros .nosotros-icono { display: flex; align-items: center; justify-content: center; flex: 0 0 48px; height: 48px; border-radius: .75rem; background: #eef5f8; color: #086c72; }
+#nosotros h3 { margin-bottom: .5rem; color: #102a43; font-size: 1.125rem; }
+#nosotros .nosotros-conceptos p { margin-bottom: 0; color: #405769; font-size: 1rem; }
+@media (max-width: 900px) {
+  #nosotros > .container { grid-template-columns: minmax(0, 1fr); }
+}
