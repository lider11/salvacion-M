+
+/* SM-FRONT-PROCESO-001 — línea de tiempo semántica sin JavaScript. */
+#proceso { background: #fff; }
+#proceso h2 { text-align: center; margin-bottom: 3rem; }
+#proceso .proceso-etapas { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 0; padding: 0; list-style: decimal inside; }
+#proceso .proceso-etapas > li { position: relative; display: flex; flex-direction: column; align-items: center; min-width: 0; padding: 0 1.25rem; text-align: center; }
+#proceso .proceso-etapas > li::marker { font-size: 0; }
+#proceso .proceso-etapas > li:not(:last-child)::after { content: ""; position: absolute; z-index: 0; top: 31px; left: 50%; width: 100%; height: 2px; background: #086c72; }
+#proceso .proceso-numero { position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; width: 64px; height: 64px; margin: 0 auto 1.5rem; border: 4px solid #fff; border-radius: 50%; background: #086c72; color: #fff; font-size: 1.25rem; font-weight: 800; }
+#proceso .proceso-contenido { position: relative; min-width: 0; overflow-wrap: anywhere; }
+#proceso .proceso-icono { display: block; margin: 0 auto 1rem; color: #086c72; }
+#proceso h3 { color: #102a43; font-size: 1.2rem; }
+#proceso .proceso-contenido p { margin: 0; color: #405769; font-weight: 400; }
+#proceso .proceso-cta { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: .75rem; width: fit-content; max-width: 100%; min-height: 48px; margin: 2.5rem auto 0; padding: .85rem 1.35rem; border-radius: .55rem; background: #102a43; color: #fff; text-align: center; text-decoration: none; font-weight: 750; overflow-wrap: anywhere; }
+#proceso .proceso-cta:hover { background: #086c72; }
+#proceso .proceso-cta:focus-visible { outline: 3px solid #086c72; outline-offset: 4px; }
+@media (max-width: 1023px) {
+  #proceso .proceso-etapas { grid-template-columns: minmax(0, 1fr); }
+  #proceso .proceso-etapas > li { display: grid; align-items: start; grid-template-columns: 64px minmax(0, 1fr); gap: 1.25rem; padding: 0 0 2rem; text-align: left; }
+  #proceso .proceso-etapas > li:last-child { padding-bottom: 0; }
+  #proceso .proceso-etapas > li:not(:last-child)::after { top: 32px; left: 31px; width: 2px; height: 100%; }
+  #proceso .proceso-numero { margin: 0; }
+  #proceso .proceso-icono { margin: .5rem 0 1rem; }
+}
+@media (max-width: 374px) {
+  #proceso .proceso-etapas > li { gap: .75rem; }
+  #proceso .proceso-cta { width: 100%; }
+}
+@media (prefers-reduced-motion: no-preference) {
+  #proceso .proceso-cta { transition: background-color 160ms ease; }
+}
