{
  "name": "salvacion-m-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Validación automatizada del frontend estático de Salvación M",
  "scripts": {
    "validate": "npm run validate:html && npm run validate:css && npm run validate:js && npm run test:a11y",
    "validate:html": "html-validate index.html privacidad.html terminos.html",
    "validate:css": "stylelint \"**/*.css\"",
    "validate:js": "eslint script.js",
    "test:a11y": "start-server-and-test \"python -m http.server 4173\" http://127.0.0.1:4173 \"pa11y-ci --config .pa11yci.json\""
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "html-validate": "^9.0.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0",
    "@axe-core/playwright": "^4.10.2",
    "pa11y-ci": "^3.1.0",
    "playwright": "^1.55.0",
    "start-server-and-test": "^2.0.10"
  },
  "type": "module"
}
