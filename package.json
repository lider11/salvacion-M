{
  "name": "salvacion-m-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Validación automatizada del frontend estático de Salvación M",
  "scripts": {
    "validate": "npm run validate:html && npm run validate:css && npm run validate:js",
    "validate:html": "html-validate index.html privacidad.html terminos.html",
    "validate:css": "stylelint \"**/*.css\"",
    "validate:js": "eslint script.js",
    "test:a11y": "npx --yes http-server . -p 4173 -a 127.0.0.1 -c-1",
    "serve": "http-server . -p 4173 -a 127.0.0.1 -c-1",
    "test:a11y:axe": "playwright test",
    "test:a11y:pa11y": "pa11y-ci --config .pa11yci.json",
    "test:g4": "node scripts/run-g4.mjs"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "html-validate": "^9.0.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0",
    "@axe-core/playwright": "^4.10.2",
    "pa11y-ci": "^3.1.0",
    "@playwright/test": "^1.55.0",
    "http-server": "^14.1.1"
  },
  "type": "module"
}
